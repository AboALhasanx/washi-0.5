# Academic Publisher — Environment Variables (MVP1)
# Copy to .env.local and fill values. Never commit .env.local.

# Summarizer provider: openai | anthropic | perplexity | local | opencode
SUMMARIZER_PROVIDER=openai

# OpenAI (used when SUMMARIZER_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only if using other providers:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENCODE_API_URL=http://localhost:8080

# Next.js — no extra vars needed for MVP1 local run
# DATABASE_URL not required (file-system only for MVP1)
